{
  "name": "raenko-hero-scene",
  "private": true,
  "version": "1.0.0",
  "description": "Сборка WebGL-сцены первого экрана raenko.pro (картинка + карта глубины) в assets/scene.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/scene.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=../../assets/scene.js",
    "test": "node test/fallback.test.mjs && node test/assets.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
